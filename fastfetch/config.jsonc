{
    "$schema":"https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.jso",
    "logo": {
    "type": "auto",
        "source": "/home/revalbtw/.config/fastfetch/cat.txt",
        "position": "left",
    //        "width": 15,
    // "height": 4,
    "padding": {
        "top": 1,
        "left": 0,
        "right": 2,
        "bottom": 0
        }
},
    "color": {
        "1": "#eed49f",
        "2": "#e5c890",
        "6": "#f5a97f",
        "7": "#fab387",
        "8": "#f9e2af",
        "9": "#ef9f76"
    },
    "display": {
    	"stat": false,
        "size": {
        "binaryPrefix": "jedec"
    },
        "separator": " "
    },
    
"modules": [

  
     {
			"type": "os",
			"key": "╭─󰣇",
			"keyColor": "magenta"
		},
		{
			"type": "kernel",
