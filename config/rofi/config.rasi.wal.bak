configuration {
    modes:              "drun";
    sorting-method:     "normal";
    show-icons:         true;
    terminal:           "kitty";
    editor:             "micro";
    matching:           "regex";
    drun-match-fields:  "name";
    /*display-run:        "Window:";
    display-ssh:        " SSH:";
    display-drun:       "󰀻 Apps:";
        display-emoji:		"󱃞 Emoji";
        */
     kb-move-char-forward: "Right";
    kb-move-char-back: "Left";
    kb-mode-next: "Alt+Right";
    kb-mode-previous: "Alt+Left";
    
}

@import "~/.cache/wal/colors-rofi-dark.rasi"



/* ── Window ───────────────────────────────────────────────────────────── */

window {
    width:            520px;
    background-color: @background;
    border-radius:    0px;
    padding:          0;
}

/* ── Main box ─────────────────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          0;
    padding:          12px;
}

/* ── Input bar ────────────────────────────────────────────────────────── */
inputbar {
    background-color: @background;
    padding:          10px 14px;
    margin:           0 0 10px 0;
    children:         [ prompt, entry ];
    spacing:          6px;
}

prompt {
    background-color: transparent;
    text-color:       @foreground;
    font:             "JetBrains Mono Bold 12";
}

entry {
    background-color: transparent;
    text-color:       @foreground;
    placeholder:      "Search…";
    placeholder-color: @foreground;
    font:             "JetBrains Mono 12";
    cursor:           text;
}

/* ── Mode switcher ────────────────────────────────────────────────────── */
mode-switcher {
    background-color: transparent;
    margin:           0 0 10px 0;
    spacing:          6px;
}

button {
    background-color: @background;
    text-color:       @foreground;
    border-radius:    0px;
    cursor:           pointer;
}

button selected {
    background-color: @foreground;
    text-color:       @background;
}

/* ── List view ────────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          4px;
    fixed-height:     false;
}

scrollbar {
    width:            4px;
    handle-width:     4px;
    background-color: @background;
    handle-color:     @background;
    border-radius:    0px;
}

/* ── List elements ────────────────────────────────────────────────────── */
element {
    background-color: transparent;
    text-color:       @foreground;
    border-radius:    0px;
    padding:          8px 10px;
    spacing:          8px;
    orientation:      horizontal;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @foreground;
}

element normal.active {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @foreground;
    text-color:       @background;
    border-color:     @background;
}

element selected.urgent {
    background-color: @background;
    text-color:       @background;
    border-color:     @background;
}

element selected.active {
    background-color: @background;
    text-color:       @foreground;
    border-color:     @foreground;
}

element-icon {
    background-color: transparent;
    size:             24px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    font:             "JetBrains Mono 12";
}

/* ── Message ──────────────────────────────────────────────────────────── */
message {
    background-color: @background;
    border-radius:    0px;
    padding:          8px 12px;
    margin:           0 0 10px 0;
}

textbox {
    background-color: transparent;
    text-color:       @foreground;
    font:             "JetBrains Mono 1i";
}
