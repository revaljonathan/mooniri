[global]
separator_color= frame
frame_color = "#8aadf4"
frame_width = 0
highlight = "#86e1fc"
font = JetBrainsMono Nerd font 14
width = (300, 900)
height = (50, 50)
progress_bar = true
progress_bar_height = 10
progress_bar_corner_radius = 4
progress_bar_frame_width = 0
progress_bar_min_width = 300
progress_bar_max_width = 300
padding = 6
origin = top-center
format = "<b>%s</b>\n<span foreground='#9399b2ff'>%a</span>\n%b"


[urgency_low]
background = "#2a2d4aff"
foreground = "#e0e0ff"

[urgency_normal]
background = "#2a2d4aff"
foreground = "#e0e0ff"

[urgency_critical]
background = "#2a2d4aff"
foreground = "#e0e0ff"

[volume_notifications]
    appname = volume
    summary = *
    history_ignore = true
    set_stack_tag = volume
    appname = volume

[brightness]
    appname = brightness
    summary = *
    history_ignore = true
    set_stack_tag = brightness


